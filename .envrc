#!/usr/bin/env bash
set -euo pipefail

# 開発時に使う共有の環境変数を読み込みます。
# `dotenv_if_exists`はファイルが存在しなければ何もしません。
# deveはtypoではなく、deve, prod, stag, testと四文字に揃えた略称です。
dotenv_if_exists .env.deve

# Nix Flakesの開発環境をロードします。
use flake . --accept-flake-config

# ComfyUIの自作カスタムノードを型検査するための環境を用意します。
# `pyrightconfig.json`はここで作る`.typecheck`を相対パスで辿るため、
# エディタもコーディングエージェントも追加の操作なしにpyrightのimport解決が効きます。
# `use flake`が`flake.lock`を監視していて、
# comfyuiの更新でdirenvが再読み込みされる時に張り直されるので、
# 更新のたびに手で実行する必要はありません。
#
# comfyuiのPython環境はCUDA版torchを含んで巨大なので、
# 実際にComfyUIを動かしているbullet以外では用意しません。
# 編集するだけのホストでdirenvに入っただけで数GBを取得してしまうためです。
if [ "$(hostname)" = bullet ]; then
  # 失敗しても開発環境自体は使えるべきなので、
  # 型検査が効かなくなったことだけを伝えて続行します。
  if ! nix build --out-link .typecheck '.#comfyui-typecheck'; then
    echo "ComfyUIカスタムノードの型検査環境を用意できませんでした。pyrightのimport解決は効きません。" >&2
  fi
fi

# ローカル固有の環境変数を最後に読み込んで優先させます。
dotenv_if_exists .env.local
