# Python

# `nix build .#typecheck --out-link .typecheck`が作るout-link。
# pyrightはここ経由でPython環境とComfyUIのソースを相対パスで辿ります。
/.typecheck

# グローバルのgitignoreで無視していてもNixのflakeソースには入ってしまい、
# ローカルでPythonやruffを動かすたびにderivationの入力が変わるため、
# リポジトリ側でも明示して除外します。
__pycache__/
.ruff_cache/

# Project

# `install.sh`がrebuild時に一時的にstagingするファイル。
# flakeはstagingされたファイルを見るため、
# `git add -f`で注入します。
/last-commit.json
