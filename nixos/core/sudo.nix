_: {
  # wheelのsudoにパスワードを求めない。
  #
  # どのホストでも、通常ユーザのセッションを握られた時点で防護はほとんど崩壊している。
  #
  # - サーバ: 入口は鍵認証のSSHだけなので、鍵が漏れればそのまま入られる。
  #   物理アクセスされる攻撃は諦めている(seminarの`boot.nix`を参照)
  # - デスクトップ: 常時ログインした状態で机に置いてあるので、
  #   物理アクセスされればそのまま操作される。サーバと同じく諦めている
  # - ラップトップ: ログインはYubiKey BioのFIDO認証なので、
  #   それを迂回されている時点でsudoのパスワードが追加で守るものは無い
  #
  # rootで初めて読める情報はsopsの秘密やgpg-vaultくらいだが、
  # ユーザのシェルを握られればsudoのaliasを仕込まれて次の操作で取られるので、
  # root権限の要求で守れる場所はほぼ無いと判断している。
  #
  # 代替も見送っている。
  # pam_u2fはTermuxのようなモバイル端末からのログインで毎回だるい。
  # 現実的に打てるパスワードにするとアカウントのパスワード自体を弱めかねない。
  security.sudo.wheelNeedsPassword = false;
}
