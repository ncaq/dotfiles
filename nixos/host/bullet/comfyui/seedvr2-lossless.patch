+class _ConsumedTensor(torch.Tensor):
+    """
+    Poison type for tensors destructively consumed by save_frames_to_video.
+
+    Any torch operation on the consumed tensor, including .shape and repr,
+    raises RuntimeError instead of silently reading data that was scaled
+    in place. del and garbage collection still work normally.
+    """
