cabal-version: 3.12
name: comfy-workflow
version: 0.1.0.0
synopsis: ComfyUIのワークフローを名前付きのオプションで投げるコマンド
license: Apache-2.0
author: ncaq <ncaq@ncaq.net>
maintainer: ncaq <ncaq@ncaq.net>
build-type: Simple

source-repository head
  type: git
  location: https://github.com/ncaq/dotfiles

common basic
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    ApplicativeDo
    BlockArguments
    CPP
    DefaultSignatures
    DerivingVia
    DuplicateRecordFields
    FunctionalDependencies
    LexicalNegation
    LinearTypes
    MonadComprehensions
    MultiWayIf
    NegativeLiterals
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    ParallelListComp
    PatternSynonyms
    QualifiedDo
    QuantifiedConstraints
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    StrictData
    TemplateHaskell
    TypeData
    TypeFamilies
    TypeFamilyDependencies
    ViewPatterns

library
  import: basic
  hs-source-dirs: src
  -- cabal-gild: discover ./src
  exposed-modules:
    ComfyWorkflow.Cli
    ComfyWorkflow.Comfy
    ComfyWorkflow.Name
    ComfyWorkflow.Parameter
    ComfyWorkflow.Prompt
    ComfyWorkflow.Seed
    ComfyWorkflow.Slot
    ComfyWorkflow.Workflow

  build-depends:
    base >=4.20.0.0 && <4.23,
    himari >=1.1.6 && <1.2,
    http-conduit >=2.3 && <2.4,
    optparse-applicative >=0.18 && <0.20,
    random >=1.2 && <1.4,
    text >=2.1 && <2.2,

executable comfy-workflow
  import: basic
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    comfy-workflow,
    himari,

test-suite comfy-workflow-test
  import: basic
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  -- cabal-gild: discover ./test --exclude ./test/Main.hs
  other-modules:
    Spec
    Spec.CliSpec
    Spec.NameSpec
    Spec.ParameterSpec
    Spec.PromptSpec
    Spec.SeedSpec
    Spec.SlotSpec
    Spec.WorkflowSpec

  build-tool-depends:
    sandwich:sandwich-discover

  build-depends:
    base,
    comfy-workflow,
    himari,
    optparse-applicative,
    sandwich >=0.3.0.5,
