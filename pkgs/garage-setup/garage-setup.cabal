cabal-version: 3.12
name: garage-setup
version: 0.1.0.0
synopsis: GarageのS3バケットとキーを用意するコマンド
license: Apache-2.0
author: ncaq <ncaq@ncaq.net>
maintainer: ncaq <ncaq@ncaq.net>
build-type: Simple

source-repository head
  type: git
  location: https://github.com/ncaq/dotfiles

common basic
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    ApplicativeDo
    BlockArguments
    CPP
    DefaultSignatures
    DerivingVia
    DuplicateRecordFields
    FunctionalDependencies
    LexicalNegation
    LinearTypes
    MonadComprehensions
    MultiWayIf
    NegativeLiterals
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    ParallelListComp
    PatternSynonyms
    QualifiedDo
    QuantifiedConstraints
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    StrictData
    TemplateHaskell
    TypeData
    TypeFamilies
    TypeFamilyDependencies
    ViewPatterns

library
  import: basic
  hs-source-dirs: src
  -- cabal-gild: discover ./src
  exposed-modules:
    GarageSetup.AccessKey
    GarageSetup.AdminToken
    GarageSetup.BucketId
    GarageSetup.BucketName
    GarageSetup.Call
    GarageSetup.Cli
    GarageSetup.Config
    GarageSetup.Failure
    GarageSetup.KeyFile
    GarageSetup.Setup
    GarageSetup.Transport

  build-depends:
    base >=4.20.0.0 && <4.23,
    bytestring >=0.12 && <0.13,
    himari >=1.1.6 && <1.2,
    http-conduit >=2.3 && <2.4,
    text >=2.1 && <2.2,
    unix >=2.8 && <2.9,

executable garage-setup
  import: basic
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    garage-setup,
    himari,

test-suite garage-setup-test
  import: basic
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  -- cabal-gild: discover ./test --exclude ./test/Main.hs
  other-modules:
    Spec
    Spec.AccessKeySpec
    Spec.AdminTokenSpec
    Spec.CallSpec
    Spec.ConfigSpec
    Spec.KeyFileSpec
    Spec.SetupSpec
    Spec.TransportSpec

  build-tool-depends:
    sandwich:sandwich-discover

  build-depends:
    base,
    garage-setup,
    himari,
    http-types >=0.12 && <0.13,
    sandwich >=0.3.0.5,
    unix,
    wai >=3.2 && <3.3,
    warp >=3.4 && <3.5,
