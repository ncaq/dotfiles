cabal-version: 3.12
name: nix-cache-push-ncaq
version: 0.1.0.0
synopsis: 認証トークンを復号して自分のNixのバイナリキャッシュへ転送するラッパ
license: Apache-2.0
author: ncaq <ncaq@ncaq.net>
maintainer: ncaq <ncaq@ncaq.net>
build-type: Simple

source-repository head
  type: git
  location: https://github.com/ncaq/dotfiles

common basic
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    ApplicativeDo
    BlockArguments
    CPP
    DefaultSignatures
    DerivingVia
    DuplicateRecordFields
    FunctionalDependencies
    LexicalNegation
    LinearTypes
    MonadComprehensions
    MultiWayIf
    NegativeLiterals
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    ParallelListComp
    PatternSynonyms
    QualifiedDo
    QuantifiedConstraints
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    StrictData
    TemplateHaskell
    TypeData
    TypeFamilies
    TypeFamilyDependencies
    ViewPatterns

library
  import: basic
  hs-source-dirs: src
  -- cabal-gild: discover ./src
  exposed-modules:
    NixCachePushNcaq.AuthToken
    NixCachePushNcaq.Cachix.CacheName
    NixCachePushNcaq.Cachix.Cli
    NixCachePushNcaq.Cachix.Command
    NixCachePushNcaq.Cachix.Config
    NixCachePushNcaq.Failure
    NixCachePushNcaq.Niks3.Cli
    NixCachePushNcaq.Niks3.Command
    NixCachePushNcaq.Niks3.Config
    NixCachePushNcaq.Niks3.ServerUrl
    NixCachePushNcaq.Niks3.StorePaths
    NixCachePushNcaq.Niks3.TokenFile
    NixCachePushNcaq.Process
    NixCachePushNcaq.Report
    NixCachePushNcaq.SecretKey
    NixCachePushNcaq.Secrets
    NixCachePushNcaq.Signal
    NixCachePushNcaq.Sops
    NixCachePushNcaq.Variable

  build-depends:
    base >=4.20.0.0 && <4.23,
    himari >=1.1.6 && <1.2,
    text >=2.1 && <2.2,
    typed-process >=0.2 && <0.3,
    unix >=2.8 && <2.9,

executable cachix-push-ncaq
  import: basic
  hs-source-dirs: app/cachix-push-ncaq
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    himari,
    nix-cache-push-ncaq,

executable niks3-push-ncaq
  import: basic
  hs-source-dirs: app/niks3-push-ncaq
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    himari,
    nix-cache-push-ncaq,

test-suite nix-cache-push-ncaq-test
  import: basic
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  -- cabal-gild: discover ./test --exclude ./test/Main.hs
  other-modules:
    Fixture
    Spec
    Spec.AuthTokenSpec
    Spec.Cachix.CliSpec
    Spec.Cachix.ConfigSpec
    Spec.Niks3.CliSpec
    Spec.Niks3.ConfigSpec
    Spec.Niks3.StorePathsSpec
    Spec.Niks3.TokenFileSpec

  build-tool-depends:
    sandwich:sandwich-discover

  build-depends:
    base,
    himari,
    nix-cache-push-ncaq,
    sandwich >=0.3.0.5,
    text,
    unix,
