cabal-version: 3.12
name: open-webui-user-settings-sync
version: 0.1.0.0
synopsis: Open WebUIの利用者ごとの設定とプロフィールを宣言へ揃えるコマンド
license: Apache-2.0
author: ncaq <ncaq@ncaq.net>
maintainer: ncaq <ncaq@ncaq.net>
build-type: Simple

source-repository head
  type: git
  location: https://github.com/ncaq/dotfiles

common basic
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    ApplicativeDo
    BlockArguments
    CPP
    DefaultSignatures
    DerivingVia
    DuplicateRecordFields
    FunctionalDependencies
    LexicalNegation
    LinearTypes
    MonadComprehensions
    MultiWayIf
    NegativeLiterals
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    ParallelListComp
    PatternSynonyms
    QualifiedDo
    QuantifiedConstraints
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    StrictData
    TemplateHaskell
    TypeData
    TypeFamilies
    TypeFamilyDependencies
    ViewPatterns

library
  import: basic
  hs-source-dirs: src
  -- cabal-gild: discover ./src
  exposed-modules:
    UserSettingsSync.Call
    UserSettingsSync.Cli
    UserSettingsSync.Config
    UserSettingsSync.Declared
    UserSettingsSync.Failure
    UserSettingsSync.Object
    UserSettingsSync.Profile
    UserSettingsSync.Settings
    UserSettingsSync.Sync
    UserSettingsSync.Token
    UserSettingsSync.Transport

  build-depends:
    base >=4.20.0.0 && <4.23,
    base64-bytestring >=1.2 && <1.3,
    bytestring >=0.12 && <0.13,
    himari >=1.1.6 && <1.2,
    http-conduit >=2.3 && <2.4,
    text >=2.1 && <2.2,

executable open-webui-user-settings-sync
  import: basic
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    himari,
    open-webui-user-settings-sync,

test-suite open-webui-user-settings-sync-test
  import: basic
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  -- cabal-gild: discover ./test --exclude ./test/Main.hs
  other-modules:
    Fixture
    Spec
    Spec.CallSpec
    Spec.ConfigSpec
    Spec.DeclaredSpec
    Spec.ProfileSpec
    Spec.SettingsSpec
    Spec.SyncSpec
    Spec.TransportSpec

  build-tool-depends:
    sandwich:sandwich-discover

  build-depends:
    base,
    bytestring,
    himari,
    http-types >=0.12 && <0.13,
    open-webui-user-settings-sync,
    sandwich >=0.3.0.5,
    wai >=3.2 && <3.3,
    warp >=3.4 && <3.5,
