cabal-version: 3.12
name: patch-gguf-chat-template
version: 0.1.0.0
synopsis: GGUFのtokenizer.chat_templateを取り出して書き戻す
license: Apache-2.0
author: ncaq <ncaq@ncaq.net>
maintainer: ncaq <ncaq@ncaq.net>
build-type: Simple

source-repository head
  type: git
  location: https://github.com/ncaq/dotfiles

common basic
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    ApplicativeDo
    BlockArguments
    CPP
    DefaultSignatures
    DerivingVia
    DuplicateRecordFields
    FunctionalDependencies
    LexicalNegation
    LinearTypes
    MonadComprehensions
    MultiWayIf
    NegativeLiterals
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    ParallelListComp
    PatternSynonyms
    QualifiedDo
    QuantifiedConstraints
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    StrictData
    TemplateHaskell
    TypeData
    TypeFamilies
    TypeFamilyDependencies
    ViewPatterns

library
  import: basic
  hs-source-dirs: src
  -- cabal-gild: discover ./src
  exposed-modules:
    PatchGgufChatTemplate.Command
    PatchGgufChatTemplate.Gguf.Failure
    PatchGgufChatTemplate.Gguf.Format
    PatchGgufChatTemplate.Gguf.Locate
    PatchGgufChatTemplate.Gguf.Reader
    PatchGgufChatTemplate.Gguf.Value
    PatchGgufChatTemplate.Pad

  build-depends:
    base >=4.20.0.0 && <4.23,
    bytestring >=0.12 && <0.13,
    himari >=1.1.6 && <1.2,

executable patch-gguf-chat-template
  import: basic
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    himari,
    patch-gguf-chat-template,

test-suite patch-gguf-chat-template-test
  import: basic
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  -- cabal-gild: discover ./test --exclude ./test/Main.hs
  other-modules:
    Fixture
    Spec
    Spec.CommandSpec
    Spec.Gguf.FormatSpec
    Spec.Gguf.LocateSpec
    Spec.PadSpec

  build-tool-depends:
    sandwich:sandwich-discover

  build-depends:
    base,
    bytestring,
    himari,
    patch-gguf-chat-template,
    sandwich >=0.3.0.5,
