cabal-version: 3.12
name: removable-crypt
version: 0.1.0.0
synopsis: 暗号化されたリムーバブルデバイスをマウントしてアンマウントするコマンド
license: Apache-2.0
author: ncaq <ncaq@ncaq.net>
maintainer: ncaq <ncaq@ncaq.net>
build-type: Simple

source-repository head
  type: git
  location: https://github.com/ncaq/dotfiles

common basic
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    ApplicativeDo
    BlockArguments
    CPP
    DefaultSignatures
    DerivingVia
    DuplicateRecordFields
    FunctionalDependencies
    LexicalNegation
    LinearTypes
    MonadComprehensions
    MultiWayIf
    NegativeLiterals
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    ParallelListComp
    PatternSynonyms
    QualifiedDo
    QuantifiedConstraints
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    StrictData
    TemplateHaskell
    TypeData
    TypeFamilies
    TypeFamilyDependencies
    ViewPatterns

library
  import: basic
  hs-source-dirs: src
  -- cabal-gild: discover ./src
  exposed-modules:
    RemovableCrypt.Cli
    RemovableCrypt.Command
    RemovableCrypt.DeviceId
    RemovableCrypt.DeviceMapperName
    RemovableCrypt.Failure
    RemovableCrypt.FilesystemType
    RemovableCrypt.MapperName
    RemovableCrypt.Mount
    RemovableCrypt.MountOption
    RemovableCrypt.System
    RemovableCrypt.Unmount
    RemovableCrypt.UserName

  build-depends:
    base >=4.20.0.0 && <4.23,
    himari >=1.1.6 && <1.2,
    optparse-applicative >=0.18 && <0.20,
    text >=2.1 && <2.2,
    unix >=2.8 && <2.9,

executable removable-crypt
  import: basic
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    himari,
    removable-crypt,

test-suite removable-crypt-test
  import: basic
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  -- cabal-gild: discover ./test --exclude ./test/Main.hs
  other-modules:
    Fixture
    Spec
    Spec.CliSpec
    Spec.CommandSpec
    Spec.DeviceMapperNameSpec
    Spec.MountSpec
    Spec.UnmountSpec
    Spec.UserNameSpec

  build-tool-depends:
    sandwich:sandwich-discover

  build-depends:
    base,
    himari,
    removable-crypt,
    sandwich >=0.3.0.5,
    text >=2.1 && <2.2,
