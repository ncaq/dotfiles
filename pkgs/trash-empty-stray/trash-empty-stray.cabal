cabal-version: 3.12
name: trash-empty-stray
version: 0.1.0.0
synopsis: trash-emptyが見つけられないゴミ箱を探して掃除するコマンド
license: Apache-2.0
author: ncaq <ncaq@ncaq.net>
maintainer: ncaq <ncaq@ncaq.net>
build-type: Simple

source-repository head
  type: git
  location: https://github.com/ncaq/dotfiles

common basic
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    ApplicativeDo
    BlockArguments
    CPP
    DefaultSignatures
    DerivingVia
    DuplicateRecordFields
    FunctionalDependencies
    LexicalNegation
    LinearTypes
    MonadComprehensions
    MultiWayIf
    NegativeLiterals
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    ParallelListComp
    PatternSynonyms
    QualifiedDo
    QuantifiedConstraints
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    StrictData
    TemplateHaskell
    TypeData
    TypeFamilies
    TypeFamilyDependencies
    ViewPatterns

library
  import: basic
  hs-source-dirs: src
  -- cabal-gild: discover ./src
  exposed-modules:
    TrashEmptyStray.AbsDir
    TrashEmptyStray.Clean
    TrashEmptyStray.Cli
    TrashEmptyStray.Failure
    TrashEmptyStray.Owner
    TrashEmptyStray.RetentionDays
    TrashEmptyStray.Search
    TrashEmptyStray.TrashDir
    TrashEmptyStray.TrashDirName

  build-depends:
    base >=4.20.0.0 && <4.23,
    containers >=0.7 && <0.8,
    filepath >=1.5 && <1.6,
    himari >=1.1.6 && <1.2,
    optparse-applicative >=0.18 && <0.20,
    os-string >=2.0 && <2.1,
    path >=0.9.6 && <0.10,
    unix >=2.8 && <2.9,

executable trash-empty-stray
  import: basic
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    himari,
    trash-empty-stray,

test-suite trash-empty-stray-test
  import: basic
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  -- cabal-gild: discover ./test --exclude ./test/Main.hs
  other-modules:
    Fixture
    Spec
    Spec.CleanSpec
    Spec.CliSpec
    Spec.SearchSpec
    Spec.TrashDirNameSpec

  build-tool-depends:
    sandwich:sandwich-discover,
    trash-empty-stray:trash-empty-stray,

  build-depends:
    base,
    himari,
    os-string,
    path,
    sandwich >=0.3.0.5,
    text >=2.1 && <2.2,
    trash-empty-stray,
    unix,
