{
  "include": ["."],
  "exclude": ["**/node_modules", "**/__pycache__", "**/.*", "result*"],
  "typeCheckingMode": "strict",
  "deprecateTypingAliases": true,
  "reportCallInDefaultInitializer": "error",
  "reportPropertyTypeMismatch": "error",
  "reportUninitializedInstanceVariable": "error",
  "reportUnnecessaryTypeIgnoreComment": "error",
  "venvPath": ".typecheck",
  "venv": "env",
  "extraPaths": [".typecheck/src"],
  "executionEnvironments": [
    {
      "root": "pkgs/comfyui-ncaq-nodes/tests",
      "extraPaths": ["pkgs/comfyui-ncaq-nodes/src"]
    },
    {
      "root": "pkgs/merge-gguf-nextn",
      "extraPaths": ["pkgs/merge-gguf-nextn/src"]
    }
  ]
}
